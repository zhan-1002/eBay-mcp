# production or sandbox
EBAY_ENV=production

# eBay Developer Program App ID / Cert ID
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional user token for future Sell API tools. Never commit a real token.
EBAY_USER_TOKEN=

# Optional explicit JSON config path; environment variables take precedence.
# EBAY_CONFIG_FILE=C:\path\to\config.local.json

EBAY_REQUEST_TIMEOUT=30
EBAY_MAX_RETRIES=2
EBAY_RETRY_BASE_DELAY=0.5

# "disabled" or "purchase_history"
EBAY_SALES_PROVIDER=disabled

# Optional logged-in purchase-history provider. Each local user gets an
# isolated browser profile; keep it outside the repository.
# EBAY_SALES_PROFILE_DIR=C:\Users\you\AppData\Local\ebay-mcp\profiles\purchase-history
# The browser is headed and minimized. It is shown only for login or
# verification. EBAY_SALES_HEADLESS is accepted for compatibility and ignored.
# Use an installed Chrome channel. Set empty to use Playwright Chromium.
EBAY_SALES_BROWSER_CHANNEL=chrome
EBAY_SALES_NAVIGATION_TIMEOUT=45
# Seconds between item IDs; requests are always serial.
EBAY_SALES_MIN_DELAY=2
# Seconds to keep the restored window open while a person finishes login
# or browser verification. Range: 30-1800.
EBAY_SALES_MANUAL_RECOVERY_TIMEOUT=900
# Seconds to wait silently after an eBay check before asking to show the window.
# Range: 0-60.
EBAY_SALES_CHALLENGE_GRACE_SECONDS=10

